# Set these in Vercel -> Project -> Settings -> Environment Variables (never commit real values)
# Use a dedicated key from a dedicated Anthropic workspace that has a monthly spend limit.
ANTHROPIC_API_KEY=

# Shared limits + cache (added automatically by the Upstash Redis integration on Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cost ceiling: total uncached searches per UTC day, all users combined (default 300)
# DAILY_SEARCH_CAP=300
# IP_WINDOW_MAX=8
# IP_DAILY_MAX=30

# Optional model override (default claude-sonnet-4-6)
# ANTHROPIC_MODEL=

# LOCAL TESTING ONLY: lets searches run outside Nov 15 - May 1. NEVER set this in Vercel Production.
# SEASON_BYPASS=1
